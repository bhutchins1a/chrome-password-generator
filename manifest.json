{
  "name": "Letter Password Generator",
  "description": "Generate a letter + 1 special character + 1 number password and auto-copy/auto-insert it.",
  "version": "1.2",
  "manifest_version": 3,
  "action": {
    "default_title": "Generate password",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "clipboardWrite"
  ],
  "commands": {
    "generate-password": {
      "description": "Generate, copy, and optionally insert a password",
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    }
  }
}

